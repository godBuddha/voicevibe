# =====================================================================
# VoiceVibe — BOOTSTRAP SECRETS
# Đây là DUY NHẤT nơi dùng biến môi trường (ngoại lệ bắt buộc lúc boot).
# MỌI cấu hình nghiệp vụ (HF token, cloud translation, models…)
# quản lý qua giao diện /admin/settings — lưu DB, secret mã hóa Fernet.
# Xem README → "Self-host trong 5 phút".
# =====================================================================

# [BẮT BUỘC] Master key mã hóa secret settings.
# Sinh bằng:  openssl rand -hex 32
SETTINGS_MASTER_KEY=

# [BẮT BUỘC khi chạy docker-compose] — compose khai báo :?set in .env:
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# LƯU TRỮ MEDIA
# ---------------------------------------------------------------------
# Mặc định: KHÔNG cần cấu hình gì. Media nằm trong volume `media` dùng chung giữa
# api và worker. Media luôn được phục vụ qua API để kiểm quyền sở hữu
# (`GET /media/{key}`), nên presigned URL không được dùng — một dịch vụ S3 nội bộ
# không mang lại lợi ích gì ở đây, chỉ thêm thứ để hỏng.
#
# Chỉ đặt 4 biến dưới khi bạn muốn lưu media ở S3 NGOÀI
# (Cloudflare R2 / AWS S3 / Backblaze B2 / MinIO tự dựng…).
# Đặt S3_ENDPOINT là storage tự chuyển sang S3Storage (app/storage.py).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ---------------------------------------------------------------------
# MẠNG
# ---------------------------------------------------------------------
# api bind vào loopback mặc định — KHÔNG phơi ra Internet khi chưa có TLS.
# Đổi thành 0.0.0.0 nếu bạn tự lo TLS phía trước (Cloudflare Tunnel, LB, nginx…).
API_BIND=127.0.0.1

# Chỉ cần khi bật profile `proxy` (Caddy + Let's Encrypt):
#   docker compose --profile proxy up -d
APP_DOMAIN=

# [Tùy chọn] Postgres cho production. BỎ TRỐNG = dùng SQLite nội bộ
# (đủ dùng cho máy cá nhân / VPS nhỏ):
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://voicevibe:CHANGE_ME@localhost:5432/voicevibe

# ---------------------------------------------------------------------
# DEV FALLBACK — chỉ có hiệu lực KHI DB chưa có entry tương ứng.
# Production: set các giá trị này qua /admin/settings thay vì ở đây.
# ---------------------------------------------------------------------

# Admin API key cho automation/script — ĐỂ TRỐNG thì đường key TẮT hoàn toàn
# (mặc định). Từ Phase 2, trang /admin dùng phiên đăng nhập; đặt giá trị ở đây
# chỉ khi bạn cần gọi API bằng key từ CI/script.
VOICEVIBE_ADMIN_KEY=

# Hugging Face token (pyannote gated — cần accept 4 repo, xem README):
HF_TOKEN=

# Cloud translation OpenAI-compatible (TÙY CHỌN — bỏ trống = dùng opus-mt
# local Apache-2.0). Hoạt động với vLLM / Ollama / llama.cpp-server / LiteLLM /
# DeepSeek / OpenAI / Groq… bất kỳ backend chuẩn OpenAI:
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=

# Dev API keys (phân cách bởi dấu phẩy) — CHỈ dùng khi phát triển.
# Không có default nữa (trước đây là dev-key-1, một backdoor luôn mở ở production),
# và nhánh này tự VÔ HIỆU ngay khi hệ thống đã có tài khoản quản trị.
VOICEVIBE_API_KEYS=

# Chế độ inline: chạy pipeline trong tiến trình API, KHÔNG cần Redis/Celery
# (mặc định khuyến nghị cho máy cá nhân / VPS nhỏ). =0 khi scale với Celery:
VOICEVIBE_INLINE=1

# ---------------------------------------------------------------------
# Phase 2 — tài khoản & phiên đăng nhập
# ---------------------------------------------------------------------

# Cookie phiên chỉ gửi qua HTTPS? Mặc định tự nhận (scheme hoặc X-Forwarded-Proto).
# Đặt =1 nếu proxy của bạn không gửi X-Forwarded-Proto mà người dùng vào bằng HTTPS.
VOICEVIBE_SECURE_COOKIES=

# Bật tài liệu API tại /docs (mặc định TẮT — schema API không nên công khai).
VOICEVIBE_ENABLE_DOCS=
