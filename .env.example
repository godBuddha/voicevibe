# =====================================================================
# YupVox-Clone — BOOTSTRAP SECRETS
# Đây là DUY NHẤT nơi dùng biến môi trường (ngoại lệ bắt buộc lúc boot).
# MỌI cấu hình nghiệp vụ (HF token, cloud translation, pricing, models…)
# quản lý qua giao diện /admin/settings — lưu DB, secret mã hóa Fernet.
# Xem README → "Self-host trong 5 phút".
# =====================================================================

# [BẮT BUỘC] Master key mã hóa secret settings.
# Sinh bằng:  openssl rand -hex 32
SETTINGS_MASTER_KEY=

# [BẮT BUỘC khi chạy docker-compose] — compose khai báo :?set in .env:
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_ROOT_USER=minioadmin
S3_BUCKET=yupvox

# [Tùy chọn] Postgres cho production. BỎ TRỐNG = dùng SQLite nội bộ
# (đủ dùng cho máy cá nhân / VPS nhỏ):
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://yupvox:CHANGE_ME@localhost:5432/yupvox

# ---------------------------------------------------------------------
# DEV FALLBACK — chỉ có hiệu lực KHI DB chưa có entry tương ứng.
# Production: set các giá trị này qua /admin/settings thay vì ở đây.
# ---------------------------------------------------------------------

# Admin key bootstrap (ĐỔI NGAY trong /admin/settings → security sau lần đầu):
YUPVOX_ADMIN_KEY=admin-dev-key

# Hugging Face token (pyannote gated — cần accept 4 repo, xem README):
HF_TOKEN=

# Cloud translation OpenAI-compatible (TÙY CHỌN — bỏ trống = dùng opus-mt
# local Apache-2.0). Hoạt động với vLLM / Ollama / llama.cpp-server / LiteLLM /
# DeepSeek / OpenAI / Groq… bất kỳ backend chuẩn OpenAI:
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=

# Dev API keys (phân cách bởi dấu phẩy). Production: tạo qua POST /v1/keys:
YUPVOX_API_KEYS=dev-key-1

# Chế độ inline: chạy pipeline trong tiến trình API, KHÔNG cần Redis/Celery
# (mặc định khuyến nghị cho máy cá nhân / VPS nhỏ). =0 khi scale với Celery:
YUPVOX_INLINE=1
